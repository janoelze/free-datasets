  "api": {
    "base_url": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service",
    "style": "rest",
    "formats": [
      "json",
      "csv",
      "xml"
    ],
    "auth": {
      "type": "none"
    },
    "cors": "any",
    "rate_limit": {
      "summary": "No numeric limit documented; fair use."
    },
    "pagination": "page"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/v2/accounting/od/debt_to_penny",
      "summary": "Total public debt outstanding",
      "params": [
        "fields",
        "sort",
        "page[size]"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/accounting/od/rates_of_exchange",
      "summary": "Treasury reporting rates of exchange",
      "params": [
        "filter"
      ]
    },
    {
      "method": "GET",
      "path": "/v2/accounting/od/avg_interest_rates",
      "summary": "Average interest rates on securities",
      "params": [
        "filter",
        "sort"
      ]
    }
  ],
  "example": {
    "method": "GET",
    "url": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v2/accounting/od/debt_to_penny?page%5Bsize%5D=1&sort=-record_date&fields=record_date,tot_pub_debt_out_amt",
